<div class="wrapper">
    <div class="panel panel-hash">
        <div class="panel-heading">
            <div class="row">
                <div class="col-md-5">
                    <a class="fa fa-plus-square fa-2x" onclick="AddEdit(0)"></a>
                </div>
                <div class="col-md-7 pull-right">
                    <h5 class="pull-right"><b>&nbsp;Document List</b></h5>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-3">
                    <div class="">
                        <label>Start Date:</label>
                        <input type="date" id="StartDate" class="" required>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="f">
                        <label>End Date:</label>
                        <input type="date" id="EndDate" class="" required>
                    </div>
                </div>
                <div class="col-sm-2">
                    <div class="">
                        <label></label>
                        <input type="button" class=" btn btn-sm btn-success" value="Submit"
                            onclick="CustomRangeDataFilter()" />
                        <input type="button" class=" btn btn-sm btn-danger" value="Reset"
                            onclick="CustomRangeDataFilter()" />
                    </div>
                </div>
                <div class="col-sm-4">
                    <label>Showing: @ViewBag.StartDate to @ViewBag.EndDate</label>
                </div>
            </div>
        </div>

        <div class="panel-body scroll panel-height">
            <table id="tblDocument" class="DMSRootColorTable" style="width:100%">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Categories</th>
                        <th>Assign</th>
                        <th>Status</th>
                        <th>Created Date</th>

                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<style>
    .panel-heading {
        padding: 0px 0px 0px 5px;
    }

    .panel-body {
        padding: 5px;
    }

    .h4 {
        margin-top: 1px;
        margin-bottom: 1px;
    }

    .form-control {
        border-radius: 5px;
        box-shadow: none;
        border-color: green;
    }
</style>

<script src="~/js/Document/Document_CRUD.js"></script>
<script src="~/js/Document/Document_Datatable.js"></script>

<script>
    $(document).ready(function () {
        DataTableCustomSearchBox('400px', 'Search Document');
    });
</script>

