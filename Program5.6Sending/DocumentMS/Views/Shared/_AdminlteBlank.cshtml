@using Microsoft.Extensions.Options;
@inject IOptions<DocumentMS.Models.CommonViewModel.ApplicationInfo> _ApplicationInfo;

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <title>@ViewData["Title"] - @_ApplicationInfo.Value.ShortName</title>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    @* <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">    *@
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <!-- Added for SEO -->
    <meta name="description" content="Document management system">
    <meta name="keywords" content="Document, management, system">
    <meta name="author" content="Henry">

    <link rel="icon" href="~/images/favicon.ico" type="image/gif" sizes="16x16">

    <link rel="stylesheet" href="~/AdminLTE/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/AdminLTE/plugins/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.min.css">
    <link rel="stylesheet" href="~/AdminLTE/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700">

</head>

<body style="background-image: url('/images/') ; background-size: cover;">
    <div class="login-container">
        <div class="row">
            <div class="col-md-8 login-form-1">
                <div class="text-center">
                    <img src='~/images/DMS1.png' alt="AdminLTE Logo"
                        class="brand-image img-circle elevation-3 imgCustom200pxCircle">
                </div>
                <br />
                <h3><a class="DMSRootColor"><b>@_ApplicationInfo.Value.FullName</b></a></h3>
                <div class="text-center">
                    <a href="@Url.Action("Login", "Account")" class="DMSRootColor" alt="Login to account" aria-label="Login to your account"></a>
                </div> <br />
                <div class="text-center">
                    <a href="@Url.Action("Index", "DocumentPublic")" class="DMSRootColor" alt="Home page" aria-label="Go to home page"></a>
                </div>
            </div>
            <div class="col-md-4 login-form-2">
                @RenderBody()
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-8">

            </div>
            <div class="col-md-4">
                <p class="login-box-msg" style="color: black;"><b>@_ApplicationInfo.Value.Version</b></p>
            </div>
        </div>
    </div>
    <link href="~/css/LoginUI.css" rel="stylesheet" />
    <script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
    <script src="~/AdminLTE/dist/js/adminlte.js"></script>
    <script src="~/AdminLTE/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    
    <link href="~/AdminLTE/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/AdminLTE/plugins/sweetalert2/sweetalert2.min.js"></script>

    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/lib/loadingoverlay.js"></script>
    <script src="~/lib/ua-parser.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>

</html>
