@model DocumentMS.Models.AccountViewModels.LoginViewModel

<nav class="main-header navbar navbar-expand navbar-white navbar-light" role="navigation">
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Toggle sidebar" name="side bar toggler">
                <i class="fas fa-bars" aria-hidden="true"></i>
                <span class="sr-only">Toggle sidebar</span>
            </a>
        </li>

    </ul>
    <ul class="navbar-nav ml-auto">
        <li>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                <input type="hidden" asp-for="Longitude" id="Longitude" />
                <input type="hidden" asp-for="Longitude" id="Latitude" />

                <div class="form-group pull-right" style="margin:10px;">
                    <button type="submit" onclick="SignOutAction()" class="btn btn-danger btn-xs" aria-label="Sign out">Sign out</button>
                </div>
            </form>
        </li>
    </ul>
</nav>

<script src="~/AdminLTE/plugins/jquery/jquery.min.js"></script>
<script src="~/js/LoginOperation.js"></script>
